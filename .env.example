# Ruta local o de VM donde esta el archivo acumulado
LGF_HOST_DATA_DIR=../bases de datos historicas
LGF_ACUM_FILE=historic_sales_acum.csv
LGF_PUBLIC_HOST=127.0.0.1

# Dentro del contenedor no se cambia: docker-compose monta LGF_HOST_DATA_DIR en /data
LGF_DATA_DIR=/data
LGF_DATA_PATH=/data/historic_sales_acum.csv
LGF_OUTPUT_DIR=/app/outputs
MLFLOW_TRACKING_URI=file:/app/mlruns
